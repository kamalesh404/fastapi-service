"""
.env.example for FastAPI Service
"""

# Application Settings
APP_NAME=FastAPI-Service
APP_VERSION=1.0.0
DEBUG=False

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=postgresql://user:password@localhost/fastapi_db

# Security Settings
SECRET_KEY=your-32-character-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Settings
API_V1_STR=/api/v1

# Optional Integrations
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...